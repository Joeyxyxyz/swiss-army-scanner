{
  "_comment": "Example command I/O mapping for the command bus (engine/control/commands.py). Hardware backends (camera GPIO, serial, digital I/O, Modbus TCP, OPC UA, EtherNet/IP) are PLACEHOLDERS (not implemented): keep them disabled. Inputs: `map` maps an input name (line, bit, coil, node, tag) to a command (START, ABORT, HOME, TRIGGER, STEP, ACK, RETRY, SKIP, ARM, DISARM, RESET, SELECT_CONFIG, SELECT_PROFILE); `signals` maps an input whose LEVEL is a sensor claim to the signal name a work state expects (part_present); a backend reports those levels for every part (a claim belongs to one cycle: the bus forgets it when the cycle ends). Outputs map a signal (READY, BUSY, PASS, FAIL, ALARM, PULL, KICKOUT, PROMPT, SENSOR_MISMATCH, and PERMIT_<NAME> for each permission of the station configuration's flow) to an output name; fieldbus outputs also write the result_code / state_code / station_config / profile / work_state / work_state_code registers named in their options. PULL = route the part to the quality-inspection lane (any doubt: INVALID, ABORTED, a guard band, an unreadable code, a work state that was not confirmed); it is never set together with PASS, and result_code then holds the INVALID / ABORTED code or the PULL code (5), never the PASS code. KICKOUT is on with FAIL or PULL (the part leaves the line). A PERMIT_<NAME> bit is true only while its work state is CONFIRMED in the current cycle: only then may the line do the next thing; the bits of a configuration that is not selected are written false. The PERMIT names here are the example tube line's (stations/example_tube_line.json).",
  "inputs": [
    {"kind": "simulated", "enabled": true,
     "map": {"trigger": "TRIGGER", "abort": "ABORT", "start": "START", "home": "HOME", "step": "STEP", "ack": "ACK"},
     "signals": {"part_present": "part_present"}},
    {"kind": "camera_gpio", "enabled": false,
     "map": {"Line0": "TRIGGER", "Line3": "ABORT"},
     "options": {"debounce_us": 1000}},
    {"kind": "serial_io", "enabled": false,
     "map": {"START": "START", "TRIG": "TRIGGER", "STOP": "ABORT", "HOME": "HOME"},
     "options": {"port": "COM5", "baud": 115200}},
    {"kind": "digital_io", "enabled": false,
     "map": {"DI0": "TRIGGER", "DI1": "ABORT", "DI2": "HOME", "DI3": "ARM", "DI5": "STEP", "DI6": "ACK"},
     "options": {"host": "192.168.0.50", "poll_ms": 10},
     "signals": {"DI4": "part_present"}},
    {"kind": "modbus_tcp", "enabled": false,
     "map": {"coil:0": "START", "coil:1": "ABORT", "coil:2": "HOME", "coil:3": "TRIGGER", "coil:4": "ARM", "coil:5": "DISARM", "coil:6": "RESET", "coil:7": "STEP", "coil:8": "ACK"},
     "options": {"host": "192.168.0.60", "port": 502, "unit": 1, "poll_ms": 10, "station_config_register": 100, "profile_register": 104},
     "signals": {"di:0": "part_present"}},
    {"kind": "opc_ua", "enabled": false,
     "map": {"ns=2;s=Cell.Start": "START", "ns=2;s=Cell.Abort": "ABORT", "ns=2;s=Cell.Home": "HOME", "ns=2;s=Cell.Trigger": "TRIGGER", "ns=2;s=Cell.Step": "STEP", "ns=2;s=Cell.Ack": "ACK"},
     "options": {"endpoint": "opc.tcp://192.168.0.61:4840", "station_config_node": "ns=2;s=Cell.StationConfig", "profile_node": "ns=2;s=Cell.Profile"},
     "signals": {"ns=2;s=Cell.PartPresent": "part_present"}},
    {"kind": "ethernet_ip", "enabled": false,
     "map": {"Cell_Start": "START", "Cell_Abort": "ABORT", "Cell_Home": "HOME", "Cell_Trigger": "TRIGGER", "Cell_Step": "STEP", "Cell_Ack": "ACK"},
     "options": {"host": "192.168.0.62", "slot": 0, "poll_ms": 10, "station_config_tag": "Cell_StationConfig", "profile_tag": "Cell_Profile"},
     "signals": {"Cell_PartPresent": "part_present"}}
  ],
  "outputs": [
    {"kind": "simulated", "enabled": true,
     "map": {}},
    {"kind": "digital_io", "enabled": false,
     "map": {"READY": "DO0", "BUSY": "DO1", "PASS": "DO2", "FAIL": "DO3", "ALARM": "DO4", "PULL": "DO5", "KICKOUT": "DO6", "PROMPT": "DO7", "SENSOR_MISMATCH": "DO8", "PERMIT_LOAD_DONE": "DO9", "PERMIT_CLAMP": "DO10", "PERMIT_TRANSFER": "DO11"},
     "options": {"host": "192.168.0.50"}},
    {"kind": "camera_gpio", "enabled": false,
     "map": {"BUSY": "Line1"}},
    {"kind": "modbus_tcp", "enabled": false,
     "map": {"READY": "coil:16", "BUSY": "coil:17", "PASS": "coil:18", "FAIL": "coil:19", "ALARM": "coil:20", "PULL": "coil:21", "KICKOUT": "coil:22", "PROMPT": "coil:23", "SENSOR_MISMATCH": "coil:24", "PERMIT_LOAD_DONE": "coil:25", "PERMIT_CLAMP": "coil:26", "PERMIT_TRANSFER": "coil:27"},
     "options": {"host": "192.168.0.60", "port": 502, "unit": 1, "result_register": 101, "state_register": 102, "station_config_register": 103, "profile_register": 105, "work_state_register": 106, "work_state_code_register": 107}},
    {"kind": "opc_ua", "enabled": false,
     "map": {"READY": "ns=2;s=Scanner.Ready", "BUSY": "ns=2;s=Scanner.Busy", "PASS": "ns=2;s=Scanner.Pass", "FAIL": "ns=2;s=Scanner.Fail", "ALARM": "ns=2;s=Scanner.Alarm", "PULL": "ns=2;s=Scanner.Pull", "KICKOUT": "ns=2;s=Scanner.Kickout", "PROMPT": "ns=2;s=Scanner.Prompt", "SENSOR_MISMATCH": "ns=2;s=Scanner.SensorMismatch", "PERMIT_LOAD_DONE": "ns=2;s=Scanner.Permit.LoadDone", "PERMIT_CLAMP": "ns=2;s=Scanner.Permit.Clamp", "PERMIT_TRANSFER": "ns=2;s=Scanner.Permit.Transfer"},
     "options": {"endpoint": "opc.tcp://192.168.0.61:4840", "result_node": "ns=2;s=Scanner.ResultCode", "station_config_node": "ns=2;s=Scanner.StationConfig", "profile_node": "ns=2;s=Scanner.Profile", "work_state_node": "ns=2;s=Scanner.WorkState", "work_state_code_node": "ns=2;s=Scanner.WorkStateCode"}},
    {"kind": "ethernet_ip", "enabled": false,
     "map": {"READY": "Scan_Ready", "BUSY": "Scan_Busy", "PASS": "Scan_Pass", "FAIL": "Scan_Fail", "ALARM": "Scan_Alarm", "PULL": "Scan_Pull", "KICKOUT": "Scan_Kickout", "PROMPT": "Scan_Prompt", "SENSOR_MISMATCH": "Scan_SensorMismatch", "PERMIT_LOAD_DONE": "Scan_Permit_LoadDone", "PERMIT_CLAMP": "Scan_Permit_Clamp", "PERMIT_TRANSFER": "Scan_Permit_Transfer"},
     "options": {"host": "192.168.0.62", "slot": 0, "result_tag": "Scan_ResultCode", "station_config_tag": "Scan_StationConfig", "profile_tag": "Scan_Profile", "work_state_tag": "Scan_WorkState", "work_state_code_tag": "Scan_WorkStateCode"}}
  ]
}
